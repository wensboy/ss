### ss.app
SS_APP_NAME = "ss"
SS_APP_VERSION = "0.1.0-dev"


### ss.server
SS_SERVER_TYPE = "rest"
### ss.server.rest
SS_SERVER_REST_LISTEN = ":8080"
### ss.server.rpc
SS_SERVER_RPC_NETWORK = "tcp"
SS_SERVER_RPC_LISTEN = ":50021"

### ss.db
SS_DB_TYPE = "mariadb"
SS_DB_NAME = "dev"
SS_DB_DSN = "root:root123@tcp(127.0.0.1:3306)/dev?loc=Local&parseTime=true&charset=utf8mb4&timeout=8s"